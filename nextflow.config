// default config file for nextflow

trace.overwrite = true

report {
    enabled = true
    overwrite = true
    file = "reports/report.html"
}
timeline {
    enabled = true
    overwrite = true
    file = "reports/timeline.html"
}
dag {
    enabled = true
    overwrite = true
    file = "reports/dag.png"
}

user = System.getenv('USER')

// Bind paths for /scratch/alpine, /projects, /pl/active are configured
// system-wide in /etc/apptainer/apptainer.conf on Alpine - no runOptions needed
apptainer.autoMounts = true

params {
    nanop_env = '/projects/.colostate.edu/dcking/software/anaconda/envs/nanop'
    medaka_sif = '/projects/.colostate.edu/dcking/software/containers/medaka_latest.sif'
}

conda.enabled = true
apptainer.enabled = true

profiles {
    // Testing profile for local execution
    testing {
        includeConfig 'config/testing.conf'
    }
    slurm {
        includeConfig 'config/alpine-slurm.conf'
    }
}
